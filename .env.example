# Azure Entra — Azure AD 應用程式設定
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:8501

# Azure AD 群組 ID 對應角色（逗號分隔，格式: group_id:role）
AZURE_GROUP_ROLE_MAP=group-id-1:admin,group-id-2:manager

# Oracle DB — 資料庫連線設定
ORACLE_HOST=your-oracle-host
ORACLE_PORT=1521
ORACLE_SERVICE=your-service-name
ORACLE_USER=your-db-user
# 使用 python -m config.crypto encrypt <密碼> 產生
ORACLE_PASSWORD_ENCRYPTED=<執行 python -m config.crypto 產生>

# Encryption — 執行 python -m config.crypto 產生
FERNET_KEY=<執行 python -m config.crypto 產生>

# App — 應用模式: demo（示範）或 production（生產）
APP_MODE=demo
