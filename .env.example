# Azure Entra
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:8501

# Azure AD Group ID to Role mapping (comma-separated group_id:role pairs)
AZURE_GROUP_ROLE_MAP=group-id-1:admin,group-id-2:manager

# Oracle DB
ORACLE_HOST=your-oracle-host
ORACLE_PORT=1521
ORACLE_SERVICE=your-service-name
ORACLE_USER=your-db-user
ORACLE_PASSWORD_ENCRYPTED=<run python -m config.crypto to generate>

# Encryption
FERNET_KEY=<run python -m config.crypto to generate>

# App
APP_MODE=demo
